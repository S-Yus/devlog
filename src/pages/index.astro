---
import { getCollection } from 'astro:content';
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isVisible, newestFirst } from '../lib/content';

const guideEntries = (await getCollection('guides')).filter(isVisible).sort(newestFirst);
const devlogEntries = (await getCollection('devlog')).filter(isVisible).sort(newestFirst);
const guides = guideEntries.slice(0, 5);
const devlog = devlogEntries.slice(0, 5);
const description = 'Yuseiの技術メモ。確認済みの手順と，開発中の記録。';
---

<BaseLayout description={description}>
  <section class="hero">
    <div>
      <p class="eyebrow">INDEX / YUSEI.DEV</p>
      <h1>Yuseiの技術メモ</h1>
    </div>
    <p>確認済みの手順は Guides，作業中の記録は Devlog。</p>
    <dl class="site-stats" aria-label="公開件数">
      <div><dt>Guides</dt><dd>{guideEntries.length}</dd></div>
      <div><dt>Devlog</dt><dd>{devlogEntries.length}</dd></div>
    </dl>
  </section>

  <div class="home-grid">
    <section aria-labelledby="latest-guides">
      <div class="section-heading">
        <h2 id="latest-guides">Guides / 最新</h2>
        <a href="/guides/">一覧 →</a>
      </div>
      <PostList posts={guides.map((entry) => ({ ...entry.data, href: `/guides/${entry.id}/`, type: 'Guide', draft: entry.data.draft }))} />
    </section>

    <section aria-labelledby="latest-devlog">
      <div class="section-heading">
        <h2 id="latest-devlog">Devlog / 最新</h2>
        <a href="/devlog/">一覧 →</a>
      </div>
      <PostList posts={devlog.map((entry) => ({ ...entry.data, href: `/devlog/${entry.id}/`, type: 'Devlog', draft: entry.data.draft }))} />
    </section>
  </div>

  <section class="split-section" aria-labelledby="current-interests">
    <div>
      <p class="eyebrow">CURRENT</p>
      <h2 id="current-interests">いま触っているもの</h2>
    </div>
    <ul class="plain-list">
      <li>WSL2 / Linux</li>
      <li>AIを使った開発</li>
      <li>技術文書</li>
      <li>小さいWebサイト</li>
    </ul>
  </section>

  <section class="project-callout" aria-labelledby="projects-heading">
    <div>
      <p class="eyebrow">WORK</p>
      <h2 id="projects-heading">Projects</h2>
      <p>準備中。</p>
    </div>
    <a class="text-link" href="/projects/">開く →</a>
  </section>
</BaseLayout>
