---
import { getCollection } from 'astro:content';
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isVisible, newestFirst } from '../lib/content';

const guides = (await getCollection('guides')).filter(isVisible).sort(newestFirst).slice(0, 4);
const devlog = (await getCollection('devlog')).filter(isVisible).sort(newestFirst).slice(0, 4);
const description = '技術ツールの実行手順、トラブルシューティング、開発・研究の記録を公開しています。';
---

<BaseLayout description={description}>
  <section class="hero">
    <p class="eyebrow">Engineering notes / Japan</p>
    <h1>Yusei.dev</h1>
    <p>{description}</p>
  </section>

  <div class="home-grid">
    <section aria-labelledby="latest-guides">
      <div class="section-heading">
        <h2 id="latest-guides">最新の Guides</h2>
        <a href="/guides/">すべて見る</a>
      </div>
      <PostList posts={guides.map((entry) => ({ ...entry.data, href: `/guides/${entry.id}/`, type: 'Guide', draft: entry.data.draft }))} />
    </section>

    <section aria-labelledby="latest-devlog">
      <div class="section-heading">
        <h2 id="latest-devlog">最新の Devlog</h2>
        <a href="/devlog/">すべて見る</a>
      </div>
      <PostList posts={devlog.map((entry) => ({ ...entry.data, href: `/devlog/${entry.id}/`, type: 'Devlog', draft: entry.data.draft }))} />
    </section>
  </div>

  <section class="split-section" aria-labelledby="current-interests">
    <div>
      <p class="eyebrow">Current interests</p>
      <h2 id="current-interests">現在の技術的関心</h2>
    </div>
    <ul class="plain-list">
      <li>ローカルファーストな開発環境</li>
      <li>AIを利用したソフトウェア開発</li>
      <li>再現可能な技術ドキュメント</li>
      <li>小さく保守できるWebサイト</li>
    </ul>
  </section>

  <section class="project-callout" aria-labelledby="projects-heading">
    <div>
      <p class="eyebrow">Selected work</p>
      <h2 id="projects-heading">Projects</h2>
      <p>制作物と技術的な試行を、背景や判断とともに順次追加します。</p>
    </div>
    <a class="text-link" href="/projects/">Projectsを見る →</a>
  </section>
</BaseLayout>
