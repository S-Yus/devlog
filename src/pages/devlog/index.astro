---
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isVisible, newestFirst } from '../../lib/content';

const entries = (await getCollection('devlog')).filter(isVisible).sort(newestFirst);
---

<BaseLayout title="Devlog" description="開発と研究の途中経過、失敗、判断の変化を残す作業記録です。">
  <header class="page-header">
    <p class="eyebrow">Work in progress</p>
    <h1>Devlog</h1>
    <p>試したこと、失敗、仮説、次の一手を、検証途中の状態も含めて記録します。</p>
  </header>
  <PostList posts={entries.map((entry) => ({ ...entry.data, href: `/devlog/${entry.id}/`, draft: entry.data.draft }))} />
</BaseLayout>
