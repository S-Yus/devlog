---
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isVisible, newestFirst } from '../../lib/content';
import { GUIDE_CATEGORY_OPTIONS } from '../../lib/guide-categories';

const entries = (await getCollection('guides')).filter(isVisible).sort(newestFirst);
---

<BaseLayout title="Guides" description="再現可能な手順と検証結果をまとめた技術ガイドです。">
  <header class="page-header">
    <p class="eyebrow">GUIDES / {entries.length}</p>
    <h1>Guides</h1>
    <p>設定，導入，トラブルシューティング。第三者が再現できる状態まで確認したもの。</p>
  </header>
  <PostList
    sortable
    filter={{ label: 'カテゴリ', options: GUIDE_CATEGORY_OPTIONS, emptyMessage: '該当するGuideはありません。' }}
    posts={entries.map((entry) => ({
      ...entry.data,
      href: `/guides/${entry.id}/`,
      filterValue: entry.data.category,
      draft: entry.data.draft,
    }))}
  />
</BaseLayout>
