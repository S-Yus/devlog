---
import type { CollectionEntry } from 'astro:content';
import CodeCopy from '../components/CodeCopy.astro';
import LikeButton from '../components/LikeButton.astro';
import BaseLayout from './BaseLayout.astro';
import { formatDateTime } from '../lib/content';
import '../styles/article.css';

interface ArticleLink {
  title: string;
  href: string;
}

type Props = (
  | { entry: CollectionEntry<'guides'>; kind: 'Guide' }
  | { entry: CollectionEntry<'devlog'>; kind: 'Devlog' }
) & {
  previous?: ArticleLink;
  next?: ArticleLink;
};

const { entry, kind, previous, next } = Astro.props;
const data = entry.data;
const isGuide = kind === 'Guide';
const isJournal = !isGuide && 'kind' in data && data.kind === 'journal';
const publishedAt = data.history[0]?.at ?? data.publishedAt;
const updatedAt = data.history.length > 1 ? data.history.at(-1)?.at : undefined;
const canonicalPath = `/${isGuide ? 'guides' : 'devlog'}/${entry.id}/`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': isJournal ? 'BlogPosting' : 'TechArticle',
  headline: data.title,
  description: data.description,
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  author: { '@type': 'Person', name: 'Yusei' },
  publisher: { '@type': 'Person', name: 'Yusei' },
  mainEntityOfPage: new URL(canonicalPath, Astro.site ?? Astro.url.origin).href,
  inLanguage: 'ja',
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonicalPath={canonicalPath}
  type="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  structuredData={structuredData}
>
  <article class="article" data-pagefind-body>
    <header class="article-header">
      <p class="eyebrow" data-pagefind-meta="type" data-pagefind-filter="type">
        {isGuide ? kind : `Devlog / ${isJournal ? 'Journal' : 'Worklog'}`}
      </p>
      <h1 data-pagefind-meta="title">{data.title}</h1>
      <p class="article-description" data-pagefind-meta="description">{data.description}</p>
      <dl class="article-facts">
        <div>
          <dt>公開</dt>
          <dd><time datetime={publishedAt.toISOString()}>{formatDateTime(publishedAt)}</time></dd>
        </div>
        {updatedAt && (
          <div>
            <dt>更新</dt>
            <dd><time datetime={updatedAt.toISOString()}>{formatDateTime(updatedAt)}</time></dd>
          </div>
        )}
        {!isGuide && 'kind' in data && (
          <div>
            <dt>種類</dt>
            <dd>{data.kind === 'journal' ? '日誌' : '作業記録'}</dd>
          </div>
        )}
        {'status' in data && (
          <div>
            <dt>状態</dt>
            <dd>{data.status}</dd>
          </div>
        )}
        {isGuide && 'estimatedMinutes' in data && (
          <div>
            <dt>目安</dt>
            <dd>{data.estimatedMinutes}分</dd>
          </div>
        )}
      </dl>
      <ul class="tag-list" aria-label="タグ">
        {data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>
    {!isGuide && (
      <aside class="devlog-notice" aria-label="Devlogについて">
        {isJournal
          ? 'この記事は日誌です。その時点で考えたことや取り組んだことを記録しています。'
          : 'この記事は開発途中の作業記録です。内容は未検証であり，後から変更される場合があります。'}
      </aside>
    )}
    <div class="article-body">
      <slot />
    </div>
    {data.history.length > 0 && (
      <section class="article-history" aria-labelledby="article-history-heading">
        <h2 id="article-history-heading">更新履歴</h2>
        <ol>
          {data.history.map((item, index) => (
            <li>
              <span>{index === 0 ? '公開' : '更新'}</span>
              <time datetime={item.at.toISOString()}>{formatDateTime(item.at)}</time>
              <p>{item.summary}</p>
            </li>
          ))}
        </ol>
      </section>
    )}
    {(previous || next) && (
      <nav class="article-pagination" aria-label="前後の記事">
        {previous && (
          <a class="article-pagination-link article-pagination-previous" href={previous.href} rel="prev">
            <span>← 前の記事</span>
            <strong>{previous.title}</strong>
          </a>
        )}
        {next && (
          <a class="article-pagination-link article-pagination-next" href={next.href} rel="next">
            <span>次の記事 →</span>
            <strong>{next.title}</strong>
          </a>
        )}
      </nav>
    )}
    <footer class="article-actions">
      <LikeButton path={canonicalPath} />
    </footer>
  </article>
  <CodeCopy />
</BaseLayout>
