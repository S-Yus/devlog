---
import { formatDate } from '../lib/content';

interface Post {
  title: string;
  description: string;
  publishedAt: Date;
  href: string;
  type?: string;
  filterValue?: string;
  draft?: boolean;
}

interface FilterOption {
  value: string;
  label: string;
}

interface FilterConfig {
  label: string;
  options: readonly FilterOption[];
  emptyMessage: string;
}

interface Props {
  posts: Post[];
  emptyMessage?: string;
  sortable?: boolean;
  filter?: FilterConfig;
}

const {
  posts,
  emptyMessage = '公開中の記事はありません。',
  sortable = false,
  filter,
} = Astro.props;
const filterOptions = filter?.options ?? [];
---

{posts.length === 0 ? (
  <p class="empty-state">{emptyMessage}</p>
) : (
  <div class="post-index" data-post-index>
    {(filterOptions.length > 0 || sortable) && (
      <div class="index-controls">
        {filterOptions.length > 0 && (
          <div class="filter-controls" role="group" aria-label={`${filter?.label ?? '記事'}で絞り込み`}>
            <span>{filter?.label ?? '絞り込み'}</span>
            <button type="button" data-post-filter="all" aria-pressed="true">すべて</button>
            {filterOptions.map((option) => (
              <button type="button" data-post-filter={option.value} aria-pressed="false">
                {option.label}
              </button>
            ))}
          </div>
        )}
        {sortable && (
          <div class="sort-controls" role="group" aria-label="記事の並び順">
            <span>並び順</span>
            <button type="button" data-sort="new" aria-pressed="true">新しい順</button>
            <button type="button" data-sort="old" aria-pressed="false">古い順</button>
            <button type="button" data-sort="rating" aria-pressed="false">高評価順</button>
          </div>
        )}
      </div>
    )}
    <p class="visually-hidden" role="status" aria-live="polite" data-sort-status></p>
    <ol class="post-list" data-post-list>
      {posts.map((post) => (
        <li
          data-path={post.href}
          data-published={post.publishedAt.valueOf()}
          data-likes="0"
          data-filter-value={post.filterValue}
        >
          <div class="post-meta">
            {post.type && <span>{post.type}</span>}
            <time datetime={post.publishedAt.toISOString()}>{formatDate(post.publishedAt)}</time>
            <span class="post-like-count" aria-label="いいね数を取得中">
              <span aria-hidden="true">+</span>
              <span data-list-like-count>…</span>
            </span>
            {post.draft && <span class="draft-label">下書き</span>}
          </div>
          <h2><a href={post.href}>{post.title}</a></h2>
          <p>{post.description}</p>
        </li>
      ))}
    </ol>
    <p class="filter-empty" data-filter-empty hidden>{filter?.emptyMessage ?? '該当する記事はありません。'}</p>
  </div>
)}

<script>
  type SortOrder = 'new' | 'old' | 'rating';

  interface LikesResponse {
    likes?: Record<string, number>;
  }

  const indexes = [...document.querySelectorAll<HTMLElement>('[data-post-index]')];

  const updateIndexView = (index: HTMLElement) => {
    const list = index.querySelector<HTMLOListElement>('[data-post-list]');
    const status = index.querySelector<HTMLElement>('[data-sort-status]');
    const empty = index.querySelector<HTMLElement>('[data-filter-empty]');
    if (!list) return;

    const selectedFilter = index.dataset.selectedFilter ?? 'all';
    const order = (index.dataset.sortOrder ?? 'new') as SortOrder;
    const items = [...list.querySelectorAll<HTMLLIElement>(':scope > li')];
    let visibleCount = 0;

    for (const item of items) {
      const visible = selectedFilter === 'all' || item.dataset.filterValue === selectedFilter;
      item.hidden = !visible;
      if (visible) visibleCount += 1;
    }

    if (empty) empty.hidden = visibleCount !== 0;
    if (status) {
      const selectedButton = index.querySelector<HTMLButtonElement>(
        `[data-post-filter="${selectedFilter}"]`,
      );
      const orderLabels: Record<SortOrder, string> = {
        new: '新しい順',
        old: '古い順',
        rating: '高評価順',
      };
      const filterLabel = selectedButton?.textContent?.trim() ?? 'すべて';
      status.textContent = `${filterLabel}、${orderLabels[order]}で${visibleCount}件を表示しています`;
    }
  };

  const sortIndex = (index: HTMLElement, order: SortOrder) => {
    const list = index.querySelector<HTMLOListElement>('[data-post-list]');
    if (!list) return;

    const items = [...list.querySelectorAll<HTMLLIElement>(':scope > li')];
    items.sort((a, b) => {
      const dateA = Number(a.dataset.published ?? 0);
      const dateB = Number(b.dataset.published ?? 0);
      const likesA = Number(a.dataset.likes ?? 0);
      const likesB = Number(b.dataset.likes ?? 0);

      if (order === 'old') return dateA - dateB;
      if (order === 'rating') return likesB - likesA || dateB - dateA;
      return dateB - dateA;
    });
    list.append(...items);
    index.dataset.sortOrder = order;

    index.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.sort === order));
    });
    updateIndexView(index);
  };

  for (const index of indexes) {
    index.dataset.selectedFilter = 'all';
    index.dataset.sortOrder = 'new';

    index.querySelectorAll<HTMLButtonElement>('[data-post-filter]').forEach((button) => {
      button.addEventListener('click', () => {
        const selectedFilter = button.dataset.postFilter;
        if (!selectedFilter) return;

        index.dataset.selectedFilter = selectedFilter;
        index.querySelectorAll<HTMLButtonElement>('[data-post-filter]').forEach((candidate) => {
          candidate.setAttribute('aria-pressed', String(candidate === button));
        });
        updateIndexView(index);
      });
    });

    index.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((button) => {
      button.addEventListener('click', () => {
        const order = button.dataset.sort;
        if (order === 'new' || order === 'old' || order === 'rating') sortIndex(index, order);
      });
    });

    updateIndexView(index);
  }

  const loadLikeCounts = async () => {
    const items = [...document.querySelectorAll<HTMLLIElement>('[data-post-index] [data-path]')];
    const paths = [...new Set(items.map((item) => item.dataset.path).filter((path): path is string => Boolean(path)))];
    const likes: Record<string, number> = {};

    for (let offset = 0; offset < paths.length; offset += 50) {
      const params = new URLSearchParams();
      for (const path of paths.slice(offset, offset + 50)) params.append('path', path);
      const response = await fetch(`/api/likes?${params}`);
      if (!response.ok) throw new Error('Failed to load likes');
      const data = (await response.json()) as LikesResponse;
      Object.assign(likes, data.likes);
    }

    for (const item of items) {
      const path = item.dataset.path;
      const count = path ? likes[path] ?? 0 : 0;
      item.dataset.likes = String(count);
      const output = item.querySelector<HTMLElement>('[data-list-like-count]');
      const container = output?.closest<HTMLElement>('.post-like-count');
      if (output) output.textContent = String(count);
      if (container) container.setAttribute('aria-label', `${count}件のいいね`);
    }

    for (const index of indexes) {
      if (index.dataset.sortOrder === 'rating') sortIndex(index, 'rating');
    }
  };

  loadLikeCounts().catch(() => {
    document.querySelectorAll<HTMLElement>('[data-list-like-count]').forEach((output) => {
      output.textContent = '—';
      output.closest<HTMLElement>('.post-like-count')?.setAttribute('aria-label', 'いいね数を取得できません');
    });
  });
</script>
