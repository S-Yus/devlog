---
const links = [
  { href: '/devlog/', label: 'Devlog' },
  { href: '/guides/', label: 'Guides' },
  { href: '/reading/', label: 'Reading' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header" data-pagefind-ignore>
  <div class="header-inner">
    <a class="site-name" href="/" aria-label="Yusei.dev ホーム">Yusei.dev</a>
    <nav aria-label="メインナビゲーション">
      <ul>
        {links.map((link) => (
          <li><a href={link.href} aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <form class="global-search" action="/search/" method="get" role="search">
      <label class="visually-hidden" for="global-search-input">記事を検索</label>
      <input id="global-search-input" name="q" type="search" placeholder="サイト内検索" autocomplete="off" />
      <button type="submit">検索</button>
    </form>
  </div>
</header>
