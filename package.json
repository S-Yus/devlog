{
  "name": "yusei-dev",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && npm run check:history && npm run check:functions",
    "check:history": "node --test scripts/history-rules.test.mjs",
    "check:functions": "tsc -p functions/tsconfig.json --noEmit",
    "build": "astro check && astro build && pagefind --site dist && npm run check:history && npm run check:functions",
    "preview": "pagefind --site dist --serve",
    "new:guide": "node scripts/new-content.mjs guide",
    "new:devlog": "node scripts/new-content.mjs devlog",
    "new:journal": "node scripts/new-content.mjs journal",
    "new:reading": "node scripts/new-content.mjs reading",
    "new:reading:deep": "node scripts/new-content.mjs reading-deep",
    "history": "node scripts/update-history.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6",
    "diff": "^9.0.0",
    "katex": "^0.18.3",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  }
}
